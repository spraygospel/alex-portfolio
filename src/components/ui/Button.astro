---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md";
  download?: boolean;
  target?: string;
  class?: string;
}

const { href, variant = "primary", size = "md", download = false, target, class: className = "" } = Astro.props;

const base = "inline-flex items-center gap-2 rounded-lg font-medium transition-colors";
const sizes = {
  sm: "text-sm px-3.5 py-1.5",
  md: "text-sm px-5 py-2.5",
};
const variants = {
  primary: "bg-accent text-white hover:bg-accent-strong",
  secondary: "border border-border bg-surface text-ink hover:border-accent hover:text-accent",
  ghost: "text-ink-muted hover:text-ink",
};

const classes = [base, sizes[size], variants[variant], className].join(" ");
const Tag = href ? "a" : "button";
---

<Tag class={classes} href={href} download={download || undefined} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}>
  <slot />
</Tag>
