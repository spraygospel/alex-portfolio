---
interface Props {
  value: string;
  label: string;
  class?: string;
}

const { value, label, class: className = "" } = Astro.props;
---

<div class:list={["p-6 rounded-2xl border border-border bg-surface", className]}>
  <p class="font-mono text-3xl md:text-4xl font-medium text-ink tracking-tight">{value}</p>
  <p class="label-mono mt-2">{label}</p>
</div>
