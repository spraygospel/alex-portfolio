---
import "../styles/global.css";
import { SITE, NAV_LINKS } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {SITE.name}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · ${SITE.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <header class="border-b border-border bg-paper/95 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-mono text-sm tracking-tight text-ink hover:text-accent transition-colors">
          {SITE.name.toLowerCase().replace(" ", ".")}
        </a>

        <nav class="hidden md:flex items-center gap-8">
          {NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-sm transition-colors",
                currentPath === link.href
                  ? "text-accent font-medium"
                  : "text-ink-muted hover:text-ink",
              ]}
            >
              {link.label}
            </a>
          ))}
          <a href={SITE.resumeUrl} class="tag-pill hover:border-accent hover:text-accent transition-colors" download>
            ↓ Resume
          </a>
        </nav>

        <label for="nav-toggle" class="md:hidden cursor-pointer p-2 -mr-2" aria-label="Toggle menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15" stroke-linecap="round" />
          </svg>
        </label>
      </div>

      <nav class="hidden peer-checked:flex md:hidden flex-col gap-1 px-6 pb-4 border-t border-border">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={["py-2 text-sm", currentPath === link.href ? "text-accent font-medium" : "text-ink-muted"]}
          >
            {link.label}
          </a>
        ))}
        <a href={SITE.resumeUrl} class="py-2 text-sm text-ink-muted" download>↓ Resume</a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border mt-24">
      <div class="mx-auto max-w-6xl px-6 py-12 flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <p class="label-mono mb-2">Get in touch</p>
          <a href={`mailto:${SITE.email}`} class="text-xl font-medium hover:text-accent transition-colors">
            {SITE.email}
          </a>
          <p class="text-sm text-ink-muted mt-1">{SITE.location} · {SITE.relocation}</p>
        </div>

        <div class="flex gap-6 font-mono text-sm text-ink-muted">
          <a href={SITE.social.github} class="hover:text-ink transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SITE.social.linkedin} class="hover:text-ink transition-colors" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
      <div class="mx-auto max-w-6xl px-6 pb-8">
        <p class="text-xs text-ink-faint">© {new Date().getFullYear()} {SITE.name}. Built with Astro.</p>
      </div>
    </footer>
  </body>
</html>
